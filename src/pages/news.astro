---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NewsCard from '../components/NewsCard.astro';
import { getNews, getPageBanners } from '../lib/content';

const [news, banners] = await Promise.all([getNews(), getPageBanners()]);
---

<Base title="News — Energy and Power Group">
  <PageHero
    eyebrow={banners.newsEyebrow || 'News'}
    title={banners.newsTitle || 'News & Updates'}
    intro={banners.newsIntro || 'Announcements, publications, events and milestones from the Energy and Power Group.'}
  />

  <section class="section">
    <div class="container">
      {news.length > 0 ? (
        <div class="grid grid-3">
          {news.map((post) => <NewsCard post={post} />)}
        </div>
      ) : (
        <p class="muted">No news posts yet — check back soon.</p>
      )}
    </div>
  </section>
</Base>
