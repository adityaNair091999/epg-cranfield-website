---
import { getSiteSettings } from '../lib/content';
const year = new Date().getFullYear();

const settings = await getSiteSettings();
const toggles = settings as Record<string, boolean | undefined>;
const allLinks = [
  { href: '/', label: 'Home', key: 'home' }, // always shown
  { href: '/research', label: 'Projects', key: 'showResearch' },
  { href: '/publications', label: 'Publications', key: 'showPublications' },
  { href: '/members', label: 'Members', key: 'showMembers' },
  { href: '/news', label: 'News', key: 'showNews' },
  { href: '/opportunities', label: 'Opportunities', key: 'showOpportunities' },
];
const links = allLinks.filter((l) => toggles[l.key] !== false);

const groupName = settings.groupName || 'Energy and Power Group';
const university = settings.university || 'Cranfield University';
const addressLines = settings.addressLines?.length
  ? settings.addressLines
  : ['Cranfield University', 'College Road, Cranfield', 'Bedford, MK43 0AL, United Kingdom'];
const email = settings.email || 'luofeng.huang@cranfield.ac.uk';
const phone = settings.phone || '+44 (0)1234 750111';
const leadName = settings.groupLeadName || 'Dr. Luofeng Huang';
const leadRole = settings.groupLeadRole || 'Lecturer in Offshore Renewable Energy';
const charityLine = settings.charityLine || 'Cranfield University is a registered charity';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__title">{groupName}</div>
        <p class="footer__addr" set:html={addressLines.join('<br />')}></p>
      </div>

      <div>
        <div class="footer__label">Navigate</div>
        <div class="footer__links">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <div>
        <div class="footer__label">Contact</div>
        <div class="footer__links">
          <a href={`mailto:${email}`}>{email}</a>
          <span>{phone}</span>
        </div>
      </div>

      <div>
        <div class="footer__label">Group Lead</div>
        <div class="footer__links">
          <span>{leadName}</span>
          <span class="footer__dim">{leadRole}</span>
          <a href="/contact">Get in touch &rarr;</a>
        </div>
      </div>
    </div>

    <div class="footer__bar">
      <span>&copy; {year} {groupName}, {university}</span>
      <span>{charityLine}</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--navy); color: rgba(242, 242, 243, 0.65); padding: 72px 0 40px; }
  .footer__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 56px; }
  .footer__title { font-family: var(--font-head); font-weight: 600; font-size: 20px; color: var(--paper); margin-bottom: 14px; }
  .footer__addr { font-size: 13.5px; line-height: 1.6; max-width: 320px; margin: 0; }
  .footer__label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(242, 242, 243, 0.5); margin-bottom: 16px; }
  .footer__links { display: flex; flex-direction: column; gap: 10px; font-size: 13.5px; }
  .footer__links a { color: var(--paper); opacity: 0.85; }
  .footer__links a:hover { opacity: 1; color: var(--paper); }
  .footer__links span { opacity: 0.85; }
  .footer__dim { opacity: 0.55 !important; }
  .footer__bar {
    border-top: 1px solid rgba(242, 242, 243, 0.15); padding-top: 24px;
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    font-size: 12px; color: rgba(242, 242, 243, 0.5);
  }
  @media (max-width: 860px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
