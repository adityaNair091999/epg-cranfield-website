# --------------------------------------------------------------------------
# Sanity connection settings
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values from your Sanity project
# (https://www.sanity.io/manage -> your project).
#
# LOCAL DEVELOPMENT uses the PUBLIC_ names below.
# On NETLIFY you can set either these PUBLIC_ names or the shorter
# SANITY_PROJECT_ID / SANITY_DATASET names — the code accepts both.
# --------------------------------------------------------------------------

# Your Sanity project ID (e.g. "7hpg0m0e")
PUBLIC_SANITY_PROJECT_ID=

# The dataset name (usually "production")
PUBLIC_SANITY_DATASET=production

# Sanity API version — leave as is unless you know you need a different date.
PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: set to false to bypass Sanity's CDN cache and see edits instantly.
# PUBLIC_SANITY_USE_CDN=false

# Optional read token — ONLY needed if you make the dataset private.
# Set this in Netlify (not committed) as SANITY_API_TOKEN.
# SANITY_API_TOKEN=
