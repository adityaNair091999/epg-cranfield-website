---
import Base from '../../layouts/Base.astro';
import PortableText from '../../components/PortableText.astro';
import { getNews } from '../../lib/content';
import { cdnImg } from '../../lib/sanity';
import { newsSlug } from '../../lib/slug';
import type { NewsPost } from '../../lib/types';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((post) => ({
    params: { slug: newsSlug(post) },
    props: { post },
  }));
}

interface Props { post: NewsPost; }
const { post } = Astro.props;

const dateStr = new Date(post.date).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Base title={`${post.title} — Energy and Power Group`}>
  <article class="post">
    <div class="post__hero">
      <div class="container">
        <a href="/news" class="post__back mono">&larr; All news</a>
        <time class="post__date mono" datetime={post.date}>{dateStr}</time>
        <h1>{post.title}</h1>
      </div>
    </div>

    <div class="container post__body-wrap">
      {post.imageUrl && (
        <div class="post__media"><img src={cdnImg(post.imageUrl, 1200)} alt={post.title} /></div>
      )}
      <div class="post__body">
        <PortableText value={post.body} />
      </div>
    </div>
  </article>
</Base>

<style>
  .post__hero { background: var(--ink); color: var(--paper); padding-block: clamp(2.5rem, 6vw, 4rem); }
  .post__back { display: inline-block; color: var(--steel-300); letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.78rem; margin-bottom: 1.4rem; }
  .post__back:hover { color: var(--accent); }
  .post__date { display: block; color: var(--accent); letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.8rem; margin-bottom: 0.7rem; }
  .post__hero h1 { color: var(--white); max-width: 20ch; }
  .post__body-wrap { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .post__media { margin-bottom: 2rem; border: 1px solid var(--border); }
  .post__body { font-size: 1.08rem; }
</style>
