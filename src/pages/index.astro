---
import Base from '../layouts/Base.astro';
import Corners from '../components/Corners.astro';
import Icon from '../components/Icon.astro';
import { getRecentNews, getFeaturedPublications, getMembers, getFeaturedProjects, getHomePage } from '../lib/content';
import { cdnImg } from '../lib/sanity';
import { newsSlug } from '../lib/slug';
import VideoEmbed from '../components/VideoEmbed.astro';

const [news, pubs, allMembers, projects, home] = await Promise.all([
  getRecentNews(),
  getFeaturedPublications(),
  getMembers(),
  getFeaturedProjects(),
  getHomePage(),
]);

// Hero + section headings (editable in Sanity → "Home Page"), with fallbacks.
const hero = {
  eyebrow: home.heroEyebrow || 'Faculty of Engineering and Applied Sciences',
  heading: home.heroHeading || 'Marine and AI systems',
  tagline: home.heroTagline || 'Engineering the offshore energy systems of the next century.',
  primaryLabel: home.heroPrimaryLabel || 'Explore Our Research',
  primaryLink: home.heroPrimaryLink || '/research',
  secondaryLabel: home.heroSecondaryLabel || 'View Publications',
  secondaryLink: home.heroSecondaryLink || '/publications',
  imageUrl: home.heroImageUrl || '/samples/hero-fpv.svg',
  videoUrl: home.heroVideoUrl || '',
  // No fallback: if the editor clears "Image/video caption" in Sanity, the
  // caption disappears entirely (that's how Luofeng can remove it).
  caption: home.heroCaption || '',
};
// Home videos — a curated list managed in Sanity (Home Page → Home videos).
const homeVideos = (home.videos ?? []).filter((v) => v.url);
// External links (DOIs, journal pages) open in a new tab; internal paths don't.
const isExternal = (href?: string) => !!href && /^https?:\/\//i.test(href);

const heads = {
  videosEyebrow: home.videosEyebrow || 'Watch',
  videosTitle: home.videosTitle || 'Gallery',
  researchEyebrow: home.researchEyebrow || 'What We Do',
  researchTitle: home.researchTitle || 'Research Highlights',
  newsEyebrow: home.newsEyebrow || 'News',
  newsTitle: home.newsTitle || 'Latest News',
  publicationsEyebrow: home.publicationsEyebrow || 'Publications',
  publicationsTitle: home.publicationsTitle || 'Featured Publications',
  teamEyebrow: home.teamEyebrow || 'People',
  teamTitle: home.teamTitle || 'Meet the Team',
};

// Team preview: current members only.
const members = allMembers.filter((m) => m.current);

// Research Highlights = featured projects (featured == true), rendered as the
// interactive card set. Clicking a card updates the detail panel below.
const icons = ['solar', 'wave', 'cfd'];
const research = projects.map((proj, i) => {
  const n = proj.relatedPublications?.length ?? 0;
  return {
    icon: icons[i % icons.length],
    title: proj.title,
    blurb: proj.description.length > 95 ? proj.description.slice(0, 95).trim() + '…' : proj.description,
    body: proj.description,
    facilities: [
      proj.status === 'ongoing' ? 'Ongoing project' : 'Completed',
      ...(n > 0 ? [`${n} related publication${n !== 1 ? 's' : ''}`] : []),
    ],
  };
});

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const excerpt = (post: (typeof news)[number]) =>
  post.body?.find((b) => b._type === 'block' && (!b.style || b.style === 'normal'))
    ?.children?.map((c) => c.text).join('') ?? '';
---

<Base title="Energy and Power Group — Cranfield University">
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__grid-bg" aria-hidden="true"></div>

      <div class="hero__text">
        <span class="hero__eyebrow">{hero.eyebrow}</span>
        <h1 class="hero__title">{hero.heading}</h1>
        <p class="hero__tag">{hero.tagline}</p>
        <div class="hero__cta">
          <a href={hero.primaryLink} class="btn">
            {hero.primaryLabel}
            <Icon name="arrow" size={16} />
          </a>
          <a href={hero.secondaryLink} class="btn btn--plain">{hero.secondaryLabel}</a>
        </div>
      </div>

      <!-- Hero figure. Upload a video in Sanity → Home Page → Hero video and it
           plays here (duotoned) instead of the image. -->
      <figure class="hero__figure blueprint">
        <div class="duotone hero__media">
          {hero.videoUrl
            ? <video src={hero.videoUrl} autoplay muted loop playsinline poster={cdnImg(hero.imageUrl, 1000)}></video>
            : <img src={cdnImg(hero.imageUrl, 1000)} alt={hero.caption} />}
        </div>
        {hero.caption && <figcaption class="hero__caption">{hero.caption}</figcaption>}
      </figure>
    </div>
  </section>

  <!-- ==================== RESEARCH HIGHLIGHTS ==================== -->
  {research.length > 0 && (
  <section id="research" class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{heads.researchEyebrow}</span>
        <h2>{heads.researchTitle}</h2>
      </div>

      <div class="grid grid-3 research__cards">
        {research.map((area, i) => (
          <button
            class:list={['research__card', 'blueprint', { 'is-active': i === 0 }]}
            data-research={i}
            type="button"
          >
            <Corners />
            <span class="research__icon"><Icon name={area.icon} size={28} /></span>
            <h3>{area.title}</h3>
            <p>{area.blurb}</p>
            <span class="research__more">Read more &rarr;</span>
          </button>
        ))}
      </div>

      <div class="research__detail blueprint">
        <Corners />
        <h4 id="rd-title">{research[0].title}</h4>
        <p id="rd-body">{research[0].body}</p>
        <div class="research__facilities" id="rd-facilities">
          {research[0].facilities.map((f) => <span class="chip">{f}</span>)}
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ========================== HOME VIDEOS ========================== -->
  {homeVideos.length > 0 && (
  <section id="gallery" class="section section--top0">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{heads.videosEyebrow}</span>
        <h2>{heads.videosTitle}</h2>
      </div>
      <div class="grid grid-3 gallgrid">
        {homeVideos.map((v) => (
          <article class="gallcard">
            <div class="gallcard__video blueprint"><VideoEmbed url={v.url!} /></div>
            {v.title && <h3 class="gallcard__title">{v.title}</h3>}
            {v.description && (
              <>
                <p class="gallcard__desc clamp">{v.description}</p>
                <button class="gallcard__toggle" type="button" hidden>Read more &darr;</button>
              </>
            )}
            {(v.projectLink || (v.papers && v.papers.length > 0)) && (
              <div class="gallcard__links">
                {v.projectLink && (
                  <a
                    class="gallcard__link"
                    href={v.projectLink}
                    target={isExternal(v.projectLink) ? '_blank' : undefined}
                    rel={isExternal(v.projectLink) ? 'noopener noreferrer' : undefined}
                  >View project &rarr;</a>
                )}
                {(v.papers ?? []).filter((p) => p.url).map((p) => (
                  <a
                    class="gallcard__link"
                    href={p.url}
                    target={isExternal(p.url) ? '_blank' : undefined}
                    rel={isExternal(p.url) ? 'noopener noreferrer' : undefined}
                  >{p.label || 'Related paper'} &rarr;</a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ======================== LATEST NEWS ======================== -->
  {news.length > 0 && (
  <section id="news" class="section section--top0">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{heads.newsEyebrow}</span>
        <h2>{heads.newsTitle}</h2>
      </div>

      <div class="grid grid-3">
        {news.map((post) => (
          <a class="newscard blueprint" href={`/news/${newsSlug(post)}`}>
            <Corners />
            <div class="newscard__top">
              <span class="chip">News</span>
              <span class="newscard__date">{fmtDate(post.date)}</span>
            </div>
            <h3>{post.title}</h3>
            <p>{excerpt(post).slice(0, 120)}{excerpt(post).length > 120 ? '…' : ''}</p>
            <span class="newscard__more">Read more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- =================== FEATURED PUBLICATIONS =================== -->
  {pubs.length > 0 && (
  <section id="publications" class="section section--top0">
    <div class="container">
      <div class="section-head pub-head">
        <div>
          <span class="eyebrow">{heads.publicationsEyebrow}</span>
          <h2>{heads.publicationsTitle}</h2>
        </div>
        <a href="/publications" class="btn btn--ghost">All publications <Icon name="arrow" size={15} /></a>
      </div>

      <div class="publist">
        {pubs.map((pub) => (
          <div class="pubrow">
            <span class="chip">{pub.year}</span>
            <div>
              <h3>{pub.title}</h3>
              <p class="pubrow__authors">{pub.authors.join(', ')}</p>
              <p class="pubrow__venue">{pub.journal}{pub.year ? `, ${pub.year}` : ''}</p>
            </div>
            {pub.doi
              ? <a href={pub.doi} target="_blank" rel="noopener" class="pubrow__link">Read paper &rarr;</a>
              : <span></span>}
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ========================= MEET THE TEAM ===================== -->
  {members.length > 0 && (
  <section id="team" class="section section--top0">
    <div class="container">
      <div class="section-head pub-head">
        <div>
          <span class="eyebrow">{heads.teamEyebrow}</span>
          <h2>{heads.teamTitle}</h2>
        </div>
        <a href="/members" class="btn btn--ghost">All members <Icon name="arrow" size={15} /></a>
      </div>

      <div class="grid grid-5 team">
        {members.slice(0, 10).map((m) => (
          <a class="teamcard" href="/members">
            <div class="teamcard__photo blueprint">
              <div class="duotone teamcard__media">
                {m.photoUrl
                  ? <img src={cdnImg(m.photoUrl, 400)} alt={m.name} loading="lazy" />
                  : <div class="teamcard__ph">{m.name.split(' ').map((n) => n[0]).join('').slice(0, 2)}</div>}
              </div>
            </div>
            <h4>{m.name}</h4>
            <p class="teamcard__role">{m.role}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

</Base>

<script define:vars={{ research }}>
  const cards = document.querySelectorAll('.research__card');
  const titleEl = document.getElementById('rd-title');
  const bodyEl = document.getElementById('rd-body');
  const facEl = document.getElementById('rd-facilities');
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const i = Number(card.dataset.research);
      cards.forEach((c) => c.classList.remove('is-active'));
      card.classList.add('is-active');
      const d = research[i];
      if (titleEl) titleEl.textContent = d.title;
      if (bodyEl) bodyEl.textContent = d.body;
      if (facEl) facEl.innerHTML = d.facilities.map((f) => `<span class="chip">${f}</span>`).join('');
    });
  });
</script>

<script>
  // Gallery: show a "Read more" toggle only when the description is clamped.
  document.querySelectorAll<HTMLElement>('.gallcard').forEach((card) => {
    const desc = card.querySelector<HTMLElement>('.gallcard__desc');
    const btn = card.querySelector<HTMLButtonElement>('.gallcard__toggle');
    if (!desc || !btn) return;
    if (desc.scrollHeight > desc.clientHeight + 2) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        desc.classList.toggle('clamp');
        const open = !desc.classList.contains('clamp');
        btn.innerHTML = open ? 'Read less &uarr;' : 'Read more &darr;';
      });
    }
  });
</script>

<style>
  /* -------- HERO -------- */
  .hero { }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
    padding-block: 88px 96px;
  }
  .hero__grid-bg {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(29,31,32,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(29,31,32,0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }
  .hero__text { position: relative; }
  .hero__eyebrow {
    display: inline-flex; align-items: center; font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--accent-dark); border: 1px solid var(--accent);
    padding: 5px 12px; margin-bottom: 24px;
  }
  .hero__title { font-size: clamp(2.8rem, 6vw, 3.6rem); line-height: 1.03; margin: 0 0 18px; }
  .hero__tag { font-size: 1.2rem; line-height: 1.5; color: var(--text-dim); max-width: 520px; margin: 0 0 32px; }
  .hero__cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }

  .hero__figure { position: relative; margin: 0; aspect-ratio: 4 / 5; border: 1px solid var(--border); }
  .hero__media { width: 100%; height: 100%; }
  .hero__caption {
    position: absolute; left: 0; bottom: 0; z-index: 3;
    font-size: 11px; letter-spacing: 0.04em; color: var(--paper);
    background: rgba(29,45,61,0.78); padding: 6px 12px;
  }
  .hero__caption .mono { color: #cfe0f0; margin-right: 6px; }

  /* -------- RESEARCH -------- */
  .section--top0 { padding-top: 0; }


  /* -------- GALLERY (grid + expandable descriptions) -------- */
  .gallgrid { align-items: start; }
  .gallcard { display: flex; flex-direction: column; }
  .gallcard__video { border: 1px solid var(--border); }
  .gallcard__title { font-size: 1.2rem; margin: 0.9rem 0 0.45rem; }
  .gallcard__desc { color: var(--text-dim); font-size: 0.94rem; line-height: 1.55; margin: 0; }
  .gallcard__desc.clamp {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
  }
  .gallcard__toggle {
    align-self: flex-start; margin-top: 0.5rem; padding: 0; background: none; border: 0; cursor: pointer;
    font-family: var(--font-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    font-size: 0.8rem; color: var(--accent-dark);
  }
  .gallcard__toggle:hover { color: var(--accent-deep); }
  .gallcard__links { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; margin-top: 0.75rem; }
  .gallcard__link {
    font-family: var(--font-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    font-size: 0.78rem; color: var(--accent-dark); text-decoration: none;
  }
  .gallcard__link:hover { color: var(--accent-deep); text-decoration: underline; }
  .research__card {
    text-align: left; font: inherit; cursor: pointer;
    background: transparent; border: 1px solid var(--border);
    padding: 28px; display: flex; flex-direction: column; gap: 10px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .research__card:hover { border-color: var(--accent); background: var(--tint); }
  .research__card.is-active { border-color: var(--accent); background: var(--tint); }
  .research__icon { color: var(--accent-dark); margin-bottom: 8px; }
  .research__card h3 { margin: 0; font-size: 1.3rem; }
  .research__card p { margin: 0; font-size: 0.92rem; color: var(--text-dim); line-height: 1.55; }
  .research__more { font-family: var(--font-head); font-weight: 600; font-size: 0.85rem; color: var(--accent-dark); margin-top: 4px; }

  .research__detail {
    margin-top: 32px; padding: 28px 32px;
    border: 1px solid var(--border); border-left: 3px solid var(--accent);
    background: var(--panel);
  }
  .research__detail h4 { font-size: 1.15rem; margin: 0 0 10px; }
  .research__detail p { font-size: 0.95rem; line-height: 1.6; color: var(--text-dim); max-width: 820px; margin: 0 0 16px; }
  .research__facilities { display: flex; gap: 10px; flex-wrap: wrap; }

  /* -------- NEWS -------- */
  .newscard {
    display: flex; flex-direction: column; gap: 12px; padding: 24px;
    border: 1px solid var(--border); color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .newscard:hover { border-color: var(--accent); background: var(--tint); }
  .newscard__top { display: flex; align-items: center; justify-content: space-between; }
  .newscard__date { font-size: 11px; color: var(--text-faint); }
  .newscard h3 { font-size: 1.2rem; line-height: 1.25; margin: 0; }
  .newscard p { font-size: 0.88rem; line-height: 1.55; color: var(--text-dim); margin: 0; flex: 1; }
  .newscard__more { font-family: var(--font-head); font-weight: 600; font-size: 0.82rem; color: var(--accent-dark); }

  /* -------- PUBLICATIONS -------- */
  .pub-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .pub-head > div { flex: 1; }
  .publist { display: flex; flex-direction: column; }
  .pubrow {
    display: grid; grid-template-columns: 90px 1fr auto; gap: 24px; align-items: start;
    padding: 22px 0; border-top: 1px solid var(--border);
  }
  .pubrow:last-child { border-bottom: 1px solid var(--border); }
  .pubrow h3 { font-size: 1.1rem; line-height: 1.3; margin: 0 0 6px; }
  .pubrow__authors { font-size: 0.88rem; color: var(--text-dim); margin: 0 0 3px; }
  .pubrow__venue { font-size: 0.82rem; color: var(--text-faint); margin: 0; }
  .pubrow__link { font-family: var(--font-head); font-weight: 600; font-size: 0.85rem; white-space: nowrap; }

  /* -------- TEAM -------- */
  .team { gap: 28px; }
  .teamcard { display: flex; flex-direction: column; gap: 12px; color: var(--ink); }
  .teamcard__photo { aspect-ratio: 1; border: 1px solid var(--border); }
  .teamcard__media { width: 100%; height: 100%; }
  .teamcard__ph {
    width: 100%; height: 100%; display: grid; place-items: center;
    font-family: var(--font-head); font-size: 2rem; color: var(--paper);
    background: var(--steel-700);
  }
  .teamcard h4 { font-size: 1rem; margin: 0 0 2px; }
  .teamcard__role { font-size: 0.78rem; color: var(--text-dim); margin: 0; line-height: 1.4; }
  .teamcard:hover h4 { color: var(--accent-dark); }

  /* -------- responsive -------- */
  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: 1fr; gap: 40px; padding-block: 56px 64px; }
    .hero__figure { max-width: 420px; }
  }
</style>
