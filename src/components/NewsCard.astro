---
import type { NewsPost } from '../lib/types';
interface Props { post: NewsPost; }
const { post } = Astro.props;

const dateStr = new Date(post.date).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
});
// First paragraph as an excerpt.
const excerpt =
  post.body?.find((b) => b._type === 'block' && (!b.style || b.style === 'normal'))
    ?.children?.map((c) => c.text).join('') ?? '';
---

<a class="news card" href={`/news/${post.slug}`}>
  {post.imageUrl && (
    <div class="news__media"><img src={post.imageUrl} alt={post.title} loading="lazy" /></div>
  )}
  <div class="news__body">
    <time class="news__date mono" datetime={post.date}>{dateStr}</time>
    <h3 class="news__title">{post.title}</h3>
    {excerpt && <p class="news__excerpt">{excerpt.slice(0, 130)}{excerpt.length > 130 ? '…' : ''}</p>}
    <span class="news__more mono">Read more &rarr;</span>
  </div>
</a>

<style>
  .news { display: flex; flex-direction: column; color: inherit; }
  .news__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--steel-800); }
  .news__media img { width: 100%; height: 100%; object-fit: cover; }
  .news__body { padding: 1.2rem 1.4rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
  .news__date { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem; }
  .news__title { font-size: 1.35rem; line-height: 1.05; margin-bottom: 0.5rem; color: var(--ink); }
  .news__excerpt { color: var(--text-dim); font-size: 0.94rem; flex: 1; }
  .news__more { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--steel-600); margin-top: 1rem; }
  .news:hover .news__title { color: var(--accent); }
  .news:hover .news__more { color: var(--accent); }
</style>
