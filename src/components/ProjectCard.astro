---
import type { Project } from '../lib/types';
interface Props { project: Project; }
const { project } = Astro.props;
---

<article class="project card">
  <div class="project__media">
    {project.imageUrl && <img src={project.imageUrl} alt={project.title} loading="lazy" />}
    <span class:list={['chip', project.status === 'ongoing' ? 'chip--ongoing' : 'chip--completed', 'project__status']}>
      {project.status}
    </span>
  </div>
  <div class="project__body">
    <h3 class="project__title">{project.title}</h3>
    <p class="project__desc">{project.description}</p>
    {project.relatedPublications?.length > 0 && (
      <div class="project__pubs">
        <span class="project__pubs-label mono">Related publications</span>
        <ul>
          {project.relatedPublications.map((pub) => (
            <li>
              {pub.doi
                ? <a href={pub.doi} target="_blank" rel="noopener">{pub.title} ({pub.year})</a>
                : <span>{pub.title} ({pub.year})</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; }
  .project__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--steel-800); }
  .project__media img { width: 100%; height: 100%; object-fit: cover; }
  .project__status { position: absolute; top: 0.9rem; left: 0.9rem; background: var(--white); }
  .project__body { padding: 1.3rem 1.4rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
  .project__title { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .project__desc { color: var(--text-dim); font-size: 0.97rem; }
  .project__pubs { margin-top: 1.1rem; border-top: 1px solid var(--border); padding-top: 0.9rem; }
  .project__pubs-label { display: block; font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--steel-400); margin-bottom: 0.4rem; }
  .project__pubs ul { margin: 0; padding-left: 1rem; }
  .project__pubs li { font-size: 0.9rem; margin-bottom: 0.3rem; }
</style>
